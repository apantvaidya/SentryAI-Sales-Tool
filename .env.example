OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional. The app uses mock AI output when OPENAI_API_KEY is not set.
# TAVILY_API_KEY is required for the People tab's warm outreach research pipeline.
# Supabase migration targets can be added later:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- lead_generation_mod (Exa searches) ---
# Required for live Exa searches.
EXA_API_KEY=your_exa_api_key_here

# Optional overrides for local runs.
EXA_API_URL=https://api.exa.ai/search
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=20
EXA_TIMEOUT_SECONDS=30

# Optional Exa user location hint.
# Example: United States
EXA_USER_LOCATION=

# --- warm_outreach ---
# Reuses OPENAI_API_KEY and TAVILY_API_KEY above. Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2
# OPENAI_TIMEOUT_SECONDS=45
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIMEOUT_SECONDS=30
