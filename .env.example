# SentryScraperModule env template. Copy to `.env` (gitignored) and fill
# in only what you need — every key is optional in dev.
#
# See `docs/RUNBOOK.md §3` for the canonical reference.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console (dev) | json (prod / compose)

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Async DSN. Defaults to file-backed SQLite when unset. Production uses
# `postgresql+asyncpg://user:pass@host:5432/db`.
DATABASE_URL=

# Set to `false` in production. The API lifespan calls `create_all` on
# startup when true, which is convenient in dev but masks schema drift.
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# Redis (cache + rate-limit + arq queue)
# ---------------------------------------------------------------------------
# Required when running the `arq` worker. Cache + rate-limit fall back to
# in-memory adapters when unset, which is fine for local dev.
REDIS_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# `slug:plaintext` pairs, comma-separated. Each slug auto-creates a tenant
# row on startup. Hashed `api_keys` rows take precedence in production.
BOOTSTRAP_API_KEYS=acme:dev-key

# ---------------------------------------------------------------------------
# Provider credentials (all optional — fakes are wired automatically)
# ---------------------------------------------------------------------------
SERPER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Smartproxy: BOTH must be set or the app falls back to MockProxy.
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=

# Browserless headless render token. Falls back to StubBrowser when unset.
BROWSERLESS_TOKEN=

# ---------------------------------------------------------------------------
# Phase 5 — rate limiting + observability
# ---------------------------------------------------------------------------
# Per-tenant token bucket. `0` disables the limiter (default in tests).
RATE_LIMIT_PER_MINUTE=0
# Bucket capacity. `0` -> 2 * RATE_LIMIT_PER_MINUTE.
RATE_LIMIT_BURST=0

# Cache TTLs (seconds). `0` disables the corresponding cache.
CACHE_SERP_TTL_SECONDS=86400      # 24h
CACHE_PROFILE_TTL_SECONDS=604800  # 7d

# Mounts `/metrics` (Prometheus text format).
METRICS_ENABLED=true
