# SentryScraperModule env template. Copy to `.env` (gitignored) and
# uncomment any variable you want to override.
#
# IMPORTANT: pydantic-settings' dotenv parser does NOT strip inline
# comments — `FOO=bar # note` becomes `bar # note`. Keep comments on
# their own lines, and leave variables COMMENTED OUT when you want
# the in-code default. Setting `FOO=` to empty overrides the default
# with the empty string, which breaks validation for several settings.
#
# See `docs/RUNBOOK.md §3` for the canonical reference.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# APP_ENV: dev | staging | prod
APP_ENV=dev
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: console (dev) | json (prod / compose)
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Async DSN. Defaults to file-backed SQLite (./sentry.db) when unset.
# Production: postgresql+asyncpg://user:pass@host:5432/db
# DATABASE_URL=postgresql+asyncpg://sentry:sentry@localhost:5432/sentry

# Set to false in production. The API lifespan calls `create_all` on
# startup when true (default).
# AUTO_CREATE_TABLES=false

# ---------------------------------------------------------------------------
# Redis (cache + rate-limit + arq queue)
# ---------------------------------------------------------------------------
# Required when running the `arq` worker. Cache + rate-limit fall back
# to in-memory adapters when unset, which is fine for local dev.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# `slug:plaintext` pairs, comma-separated. Each slug auto-creates a
# tenant row on startup. Hashed `api_keys` rows take precedence in
# production.
BOOTSTRAP_API_KEYS=acme:dev-key

# ---------------------------------------------------------------------------
# Provider credentials (all optional — fakes are wired automatically)
# ---------------------------------------------------------------------------
# SERPER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Smartproxy: BOTH must be set or the app falls back to MockProxy.
# SMARTPROXY_USERNAME=
# SMARTPROXY_PASSWORD=

# Browserless headless render token. Falls back to StubBrowser.
# BROWSERLESS_TOKEN=

# ---------------------------------------------------------------------------
# Phase 5 — rate limiting + observability
# ---------------------------------------------------------------------------
# Per-tenant token bucket. 0 disables the limiter (default).
# RATE_LIMIT_PER_MINUTE=60
# Bucket capacity. 0 -> 2 * RATE_LIMIT_PER_MINUTE.
# RATE_LIMIT_BURST=120

# Cache TTLs (seconds). 0 disables the corresponding cache.
# CACHE_SERP_TTL_SECONDS=86400
# CACHE_PROFILE_TTL_SECONDS=604800

# Mounts /metrics (Prometheus text format).
METRICS_ENABLED=true
